# Base de datos (docker compose de /infra)
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=agentforge
S3_SECRET_KEY=agentforge-secret
S3_BUCKET=agentforge-workspaces

# Auth
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_MINUTES=1440

# Proveedores LLM (deja vacío el que no uses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
